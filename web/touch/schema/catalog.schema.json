{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devs-guide.github.io/chrome/web/touch/schema/catalog.schema.json",
  "title": "Chrome Web Touch Test Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "suiteVersion",
    "resultStates",
    "tests",
    "profiles",
    "sources"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "string", "minLength": 1 },
    "resultStates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "instructions",
          "expected",
          "requiresSecureContext",
          "requiresPermission",
          "requiresUserGesture",
          "requiresHardware",
          "requiresInternet",
          "requiresSpecialServer",
          "requiresMultipleOrigins",
          "offlineCapable",
          "destructivePotential",
          "privacySensitivity",
          "automationLevel"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "automationLevel": {
            "enum": ["AUTO", "SEMI-AUTO", "HUMAN", "EXTERNAL-HARDWARE", "SERVER-DEPENDENT"]
          }
        },
        "additionalProperties": true
      }
    },
    "profiles": { "type": "array" },
    "sources": { "type": "array" }
  },
  "additionalProperties": false
}
