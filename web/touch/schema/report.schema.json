{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devs-guide.github.io/chrome/web/touch/schema/report.schema.json",
  "title": "Chrome Web Touch Diagnostic Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "suiteVersion",
    "catalogVersion",
    "runId",
    "createdAt",
    "secureContext",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suiteVersion": { "type": "string", "minLength": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "secureContext": { "type": "boolean" },
    "browser": { "type": "object" },
    "platform": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "expected-unavailable",
              "unexpected-unavailable",
              "skipped",
              "not-exercised"
            ]
          },
          "expected": {},
          "observed": {},
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
